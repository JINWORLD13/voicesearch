PORT=3001

# gemini 또는 openai
LLM_PROVIDER=gemini

# Google AI Studio에서 무료 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 신규 발급 키는 gemini-2.5 계열을 못 쓴다. 3.x flash 계열 사용.
GEMINI_MODEL=gemini-3.6-flash

# LLM_PROVIDER=openai로 쓸 때만 필요
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 웹 검색(선택). 비워두면 Gemini 내장 구글 검색(grounding)으로 동작한다.
# Exa를 쓰면 검색 결과(5건, 본문 발췌)를 직접 제어하고 답변에 [1] 출처
# 번호가 달린다. https://exa.ai 가입하면 무료 크레딧을 준다.
EXA_API_KEY=

# 음성 합성. https://elevenlabs.io 무료 플랜(월 1만 크레딧).
# 비워두면 브라우저 내장 음성으로 폴백한다.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# 대시보드의 장애 주입/메트릭 리셋을 보호하는 토큰(선택).
# 비워두면(기본값) 방문자 누구나 대시보드에서 장애 주입을 체험할 수 있다(포트폴리오
# 데모 의도). 방치된 주입은 마지막 조작 10분 뒤 자동 정상화된다.
# 잠그고 싶으면 값을 채우고, 그러면 x-admin-token 헤더가 일치해야 한다.
ADMIN_TOKEN=
